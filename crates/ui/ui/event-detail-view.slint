import { Theme } from "theme.slint";

component ActionButton inherits Rectangle {
    in property <string> label;
    callback tapped();

    border-radius: 10px;
    background: touch.pressed ? Theme.border : Theme.surface-alt;
    border-width: 1px;
    border-color: Theme.border;

    touch := TouchArea {
        clicked => { tapped(); }
        Text {
            text: label;
            font-size: 15px;
            font-weight: 700;
            color: Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Read-only: Home Assistant doesn't expose a delete/update service for this
// calendar integration (checked against a real instance's /api/services --
// only create_event and get_events are registered for the calendar domain
// at all), so there's nothing for a "Delete" button here to actually call.
export component EventDetailView inherits Rectangle {
    in property <bool> open: false;
    in property <string> summary;
    in property <string> time-label;
    // Comma-joined name(s) -- precomputed in Rust for shared events.
    in property <string> member-name;
    in property <[color]> member-colors;
    callback closed();

    visible: open;
    width: 100%;
    height: 100%;
    background: #14161f99;
    z: 1000;

    // Tapping outside the card dismisses it.
    TouchArea {
        clicked => { root.closed(); }
    }

    Rectangle {
        width: 420px;
        height: 240px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.border;

        VerticalLayout {
            padding: 22px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 22px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    clip: true;

                    HorizontalLayout {
                        width: 100%;
                        height: 100%;
                        if root.member-colors.length == 0: Rectangle { background: Theme.border; }
                        for c in root.member-colors: Rectangle {
                            horizontal-stretch: 1;
                            background: c;
                        }
                    }
                }
                Text {
                    text: root.member-name;
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.summary;
                font-size: 19px;
                font-weight: 700;
                color: Theme.text-primary;
                wrap: word-wrap;
            }
            Text {
                text: root.time-label;
                font-size: 14px;
                color: Theme.text-muted;
            }

            Rectangle { vertical-stretch: 1; }

            Text {
                text: "Editing and deleting aren't available from this dashboard -- use the Home Assistant app.";
                font-size: 11px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }

            ActionButton {
                label: "Close";
                tapped => { root.closed(); }
            }
        }
    }
}
