import { Theme } from "theme.slint";

export struct MusicRowData {
    // Album art, filled in asynchronously after the row first appears -- empty
    // until it arrives, which is why the row draws a placeholder behind it.
    art: image,
    // Pads a short final grid row. Cells stretch to share the row, so without
    // padding the last row's covers would balloon to fill the width.
    filler: bool,
    title: string,
    subtitle: string,
    // Right-hand detail: a track's duration, or an album count.
    trailing: string,
    // Tracks start playback; everything else drills in. Drives the chevron.
    playable: bool,
}

// A row of grid cells. Nested array rather than a flat list because Slint has
// no wrapping layout -- Rust chunks the albums into rows, the same shape the
// dashboard already uses for its cards.
export struct MusicGridRowData {
    cells: [MusicRowData],
}

// One album in the grid: a big square cover with its name under it.
component AlbumCell inherits VerticalLayout {
    in property <MusicRowData> data;
    callback tapped();

    spacing: 6px;
    // Every cell is the same width regardless of what's in it. Without these
    // the cover's own pixel size becomes the cell's preferred width, so cells
    // with art and cells without end up different sizes in the same row.
    horizontal-stretch: 1;
    preferred-width: 0px;
    min-width: 0px;

    Rectangle {
        // Square, driven by whatever width the row's stretch gives it, so the
        // grid stays aligned at any resolution. Deliberately not computed from
        // parent.width: inside a Flickable that feeds back through the
        // viewport and Slint rejects it as a binding loop.
        height: self.width;
        preferred-width: 0px;
        min-width: 0px;
        border-radius: 8px;
        background: root.data.filler ? transparent : Theme.border;
        clip: true;

        Image {
            width: 100%;
            height: 100%;
            source: root.data.art;
            image-fit: cover;
        }

        // Covers the artwork rather than the whole cell: the text below is
        // elided and narrow, and a tap target that includes it would overlap
        // its neighbour's artwork on a touchscreen.
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                if (!root.data.filler) { root.tapped(); }
            }
        }
    }

    Text {
        text: root.data.title;
        font-size: 13px;
        font-weight: 600;
        color: Theme.text-primary;
        overflow: elide;
    }

    Text {
        text: root.data.subtitle;
        font-size: 11px;
        color: Theme.text-muted;
        overflow: elide;
        visible: root.data.subtitle != "";
    }
}

component SectionChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback tapped();

    height: 34px;
    border-radius: 17px;
    background: root.active ? Theme.accent : (touch.pressed ? Theme.surface-alt : transparent);
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border;

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.tapped(); }
    }

    Text {
        text: root.label;
        font-size: 13px;
        font-weight: 600;
        color: root.active ? white : Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component TransportButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> prominent: false;
    callback tapped();

    width: root.prominent ? 64px : 54px;
    height: root.prominent ? 64px : 54px;
    border-radius: self.width / 2;
    background: root.prominent
        ? (touch.pressed ? Theme.accent.darker(0.15) : Theme.accent)
        : (touch.pressed ? Theme.border : transparent);

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.tapped(); }
    }

    Text {
        text: root.glyph;
        font-size: root.prominent ? 23px : 20px;
        font-weight: 700;
        color: root.prominent ? white : Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Volume stepper. A press steps once; holding repeats in bigger increments,
// which is the difference between nudging a level and crossing the dial.
//
// Driven by pointer-event rather than `clicked`: `clicked` only fires on
// release, so a press-and-hold would apply its step *after* the repeat had
// already run, double-counting the gesture.
component VolumeButton inherits Rectangle {
    in property <string> glyph;
    // +1 or -1.
    in property <int> direction;
    callback pressed(int);
    callback released();

    width: 54px;
    height: 54px;
    border-radius: 27px;
    background: touch.pressed ? Theme.border : transparent;

    touch := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.pressed(root.direction);
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.released();
            }
        }
    }

    Text {
        text: root.glyph;
        font-size: 24px;
        font-weight: 700;
        color: Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component MusicRow inherits Rectangle {
    // Named `data`, not `row`: `row` is reserved (GridLayout placement).
    in property <MusicRowData> data;
    callback tapped();

    height: 58px;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.surface-alt : transparent;

    // Explicitly sized rather than relying on "sole child fills parent" --
    // there are siblings, and that implicit sizing is what once cost this
    // project an entirely touch-dead page (see CLAUDE.md).
    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.tapped(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        // Fixed-size art well, always present: the artwork arrives after the
        // row does, and a slot that appears later would make the whole list
        // jump as covers load in.
        Rectangle {
            width: 44px;
            height: 44px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: Theme.border;
            clip: true;

            Image {
                width: 100%;
                height: 100%;
                source: root.data.art;
                image-fit: cover;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;

            Text {
                text: root.data.title;
                font-size: 15px;
                color: Theme.text-primary;
                overflow: elide;
            }

            Text {
                text: root.data.subtitle;
                font-size: 11px;
                color: Theme.text-muted;
                visible: root.data.subtitle != "";
                overflow: elide;
            }
        }

        Text {
            text: root.data.trailing;
            font-size: 12px;
            color: Theme.text-muted;
            vertical-alignment: center;
        }

        Text {
            // "Play" rather than a triangle glyph: one embedded font, no
            // fallback, so an unavailable glyph renders as tofu.
            text: root.data.playable ? "Play" : "›";
            font-size: root.data.playable ? 11px : 20px;
            font-weight: root.data.playable ? 700 : 400;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
    }
}

// The Music tab: browse a Navidrome library, play it on a Home Assistant
// media_player.
//
// Deliberately a dumb renderer. Rust owns which level of the browse hierarchy
// is showing and hands over already-labelled rows, exactly as the time zone
// picker does, so the navigation rules stay in testable Rust rather than in
// markup.
export component MusicPage inherits Rectangle {
    // False until a server has been set up; drives the connect prompt.
    in property <bool> configured: false;
    // Progress, or why something failed.
    in property <string> message: "";
    in property <bool> busy: false;

    // Now playing, read from the target media_player's own HA state.
    in property <bool> player-configured: false;
    in property <string> player-name: "";
    in property <string> now-playing-title: "";
    in property <string> now-playing-artist: "";
    in property <bool> now-playing-active: false;
    in property <image> now-playing-art;
    // Empty when the player doesn't report a level; the controls still work,
    // they just step via volume_up/volume_down instead.
    in property <string> volume-label: "";
    // Swaps the browse area for the full-size now-playing view. Stays inside
    // the page, so the sidebar and header are untouched.
    in property <bool> now-playing-view: false;

    in property <[string]> sections: [];
    in property <int> selected-section: 0;
    in property <string> heading: "";
    in property <bool> can-go-back: false;
    in property <[MusicRowData]> rows: [];
    // Albums are shown as a wall of covers rather than a list; everything else
    // (tracks, artists, playlists, speakers) stays a list.
    in property <bool> grid-mode: false;
    in property <[MusicGridRowData]> grid-rows: [];
    in property <int> grid-columns: 4;
    callback cell-selected(int);

    // Album ordering. Only meaningful on the album list, hence the visibility
    // flag rather than always showing a row of chips that do nothing.
    in property <bool> sorts-visible: false;
    in property <[string]> sorts: [];
    in property <int> selected-sort: 0;
    // Another page may exist. False for short pages and for Random, which
    // reshuffles per request so "more" would just overlap what's shown.
    in property <bool> can-load-more: false;

    callback sort-selected(int);
    callback load-more();
    callback setup-requested();
    callback section-selected(int);
    callback row-selected(int);
    callback back();
    callback choose-player();
    callback play-pause();
    callback next-track();
    callback previous-track();
    callback volume-pressed(int);
    callback volume-released();
    callback open-now-playing();
    callback close-now-playing();

    background: Theme.surface;
    border-radius: Theme.radius;
    clip: true;

    // --- Not set up yet -------------------------------------------------
    if !root.configured: VerticalLayout {
        padding: 28px;
        spacing: 14px;
        alignment: center;

        Text {
            text: "Music";
            font-size: 22px;
            font-weight: 700;
            color: Theme.text-primary;
            horizontal-alignment: center;
        }

        Text {
            text: "Connect your music library to browse it here and play it on a speaker.";
            font-size: 14px;
            color: Theme.text-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if root.message != "": Text {
            text: root.message;
            font-size: 13px;
            color: Theme.text-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Rectangle {
            height: 46px;
            width: 240px;
            x: (parent.width - self.width) / 2;
            border-radius: 10px;
            background: connect-touch.pressed ? Theme.accent.darker(0.15) : Theme.accent;

            connect-touch := TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.setup-requested(); }
            }

            Text {
                text: root.busy ? "Connecting..." : "Set up music server";
                font-size: 14px;
                font-weight: 700;
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // --- Now playing, full size -----------------------------------------
    if root.configured && root.now-playing-view: VerticalLayout {
        padding: 18px;
        spacing: 14px;

        HorizontalLayout {
            height: 44px;
            spacing: 10px;

            Rectangle {
                width: 150px;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                background: back-np-touch.pressed ? Theme.surface-alt : transparent;

                back-np-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.close-now-playing(); }
                }

                Text {
                    text: "‹  Back to music";
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle { horizontal-stretch: 1; }
        }

        // The cover, as large as the remaining space allows and still square.
        Rectangle {
            vertical-stretch: 1;
            horizontal-stretch: 1;

            Rectangle {
                // Square: whichever of the available width/height is smaller.
                width: min(parent.width, parent.height);
                height: self.width;
                x: (parent.width - self.width) / 2;
                border-radius: 12px;
                background: Theme.border;
                clip: true;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.now-playing-art;
                    image-fit: contain;
                }
            }
        }

        Text {
            text: root.now-playing-title != "" ? root.now-playing-title : "Nothing playing";
            font-size: 24px;
            font-weight: 700;
            color: Theme.text-primary;
            horizontal-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.now-playing-artist;
            font-size: 15px;
            color: Theme.text-muted;
            horizontal-alignment: center;
            overflow: elide;
            visible: root.now-playing-artist != "";
        }

        // Tappable, because the speaker was previously a one-way choice: the
        // picker only appeared while none was set, so there was no way to move
        // the music to a different room afterwards.
        HorizontalLayout {
            height: 40px;
            alignment: center;

            Rectangle {
                width: 300px;
                border-radius: 20px;
                border-width: 1px;
                border-color: Theme.border;
                background: speaker-touch.pressed ? Theme.surface-alt : transparent;

                speaker-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.choose-player(); }
                }

                Text {
                    text: root.player-name != ""
                        ? "Playing on " + root.player-name + "  -  change"
                        : "Choose a speaker";
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        HorizontalLayout {
            height: 70px;
            spacing: 14px;
            alignment: center;

            TransportButton {
                glyph: "|<";
                tapped => { root.previous-track(); }
            }
            TransportButton {
                glyph: root.now-playing-active ? "||" : ">";
                prominent: true;
                tapped => { root.play-pause(); }
            }
            TransportButton {
                glyph: ">|";
                tapped => { root.next-track(); }
            }

            Rectangle { width: 28px; }

            VolumeButton {
                glyph: "-";
                direction: -1;
                pressed(d) => { root.volume-pressed(d); }
                released => { root.volume-released(); }
            }
            Text {
                text: root.volume-label;
                font-size: 19px;
                font-weight: 600;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-alignment: center;
                width: 68px;
            }
            VolumeButton {
                glyph: "+";
                direction: 1;
                pressed(d) => { root.volume-pressed(d); }
                released => { root.volume-released(); }
            }
        }
    }

    // --- Set up ---------------------------------------------------------
    if root.configured && !root.now-playing-view: VerticalLayout {
        padding: 18px;
        spacing: 12px;

        // Now playing / transport.
        Rectangle {
            height: 96px;
            border-radius: Theme.radius;
            background: Theme.surface-alt;
            border-width: 1px;
            border-color: Theme.border;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 16px;
                spacing: 10px;

                // Always present, so the bar doesn't reflow when art arrives.
                Rectangle {
                    width: 52px;
                    height: 52px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 6px;
                    background: Theme.border;
                    clip: true;

                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.now-playing-art;
                        image-fit: cover;
                    }
                }

                // Tapping the text opens the full view; the transport buttons
                // beside it keep their own targets.
                Rectangle {
                    horizontal-stretch: 1;
                    background: bar-touch.pressed ? Theme.border : transparent;
                    border-radius: 8px;

                    bar-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.open-now-playing(); }
                    }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: root.player-configured
                            ? (root.now-playing-title != "" ? root.now-playing-title : "Nothing playing")
                            : "No speaker chosen";
                        font-size: 15px;
                        font-weight: 600;
                        color: Theme.text-primary;
                        overflow: elide;
                    }

                    Text {
                        text: root.player-configured
                            ? (root.now-playing-artist != ""
                                ? root.now-playing-artist + " - " + root.player-name
                                : root.player-name)
                            : "Pick where music should play";
                        font-size: 11px;
                        color: Theme.text-muted;
                        overflow: elide;
                    }
                }
                }

                // Shown whether or not a speaker is set: picking one used to be
                // a one-way door, with no way back to the picker afterwards.
                Rectangle {
                    width: 128px;
                    height: 44px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: pick-touch.pressed ? Theme.border : transparent;

                    pick-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.choose-player(); }
                    }

                    Text {
                        text: root.player-configured ? "Change speaker" : "Choose speaker";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if root.player-configured: HorizontalLayout {
                    spacing: 6px;
                    TransportButton {
                        glyph: "|<";
                        tapped => { root.previous-track(); }
                    }
                    TransportButton {
                        glyph: root.now-playing-active ? "||" : ">";
                        prominent: true;
                        tapped => { root.play-pause(); }
                    }
                    TransportButton {
                        glyph: ">|";
                        tapped => { root.next-track(); }
                    }

                    Rectangle { width: 12px; }

                    VolumeButton {
                        glyph: "-";
                        direction: -1;
                        pressed(d) => { root.volume-pressed(d); }
                        released => { root.volume-released(); }
                    }
                    // Shows the level when the player reports one; the buttons
                    // work either way.
                    Text {
                        text: root.volume-label;
                        font-size: 17px;
                        font-weight: 600;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        width: 62px;
                    }
                    VolumeButton {
                        glyph: "+";
                        direction: 1;
                        pressed(d) => { root.volume-pressed(d); }
                        released => { root.volume-released(); }
                    }
                }
            }
        }

        // Section chips.
        HorizontalLayout {
            spacing: 8px;
            height: 34px;

            for section[idx] in root.sections: SectionChip {
                label: section;
                active: idx == root.selected-section;
                tapped => { root.section-selected(idx); }
            }

            Rectangle { horizontal-stretch: 1; }
        }

        if root.sorts-visible: HorizontalLayout {
            spacing: 8px;
            height: 30px;

            for sort[idx] in root.sorts: SectionChip {
                label: sort;
                active: idx == root.selected-sort;
                tapped => { root.sort-selected(idx); }
            }

            Rectangle { horizontal-stretch: 1; }
        }

        // Heading + back.
        HorizontalLayout {
            height: 44px;
            spacing: 12px;

            // Same size and shape as the now-playing view's back button: a
            // bare chevron was a hard target to hit on a touchscreen.
            if root.can-go-back: Rectangle {
                width: 110px;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                background: back-touch.pressed ? Theme.surface-alt : transparent;

                back-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.back(); }
                }

                Text {
                    text: "‹  Back";
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.heading;
                font-size: 16px;
                font-weight: 700;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }

        if root.message != "": Text {
            text: root.message;
            font-size: 12px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }

        if root.grid-mode: Flickable {
            // Without this the viewport takes the content's preferred width,
            // which is what the rows are trying to derive their width *from* --
            // so the grid sized itself to its covers and filled about half the
            // screen. Pinning it to the Flickable's own width gives the rows a
            // real width to divide up, and only scrolls vertically.
            viewport-width: self.width;

            VerticalLayout {
                width: parent.width;
                spacing: 16px;
                alignment: start;

                if root.grid-rows.length == 0: Text {
                    text: root.busy ? "Loading..." : "Nothing here.";
                    font-size: 13px;
                    color: Theme.text-muted;
                }

                // No `alignment` here on purpose: an aligned layout hands every
                // child its *preferred* size and ignores stretch, so cells with
                // a decoded cover claimed its full pixel size while artless ones
                // collapsed -- a ragged half-width grid. Unaligned, stretch
                // divides the row evenly and every cell matches.
                for grid-row[ridx] in root.grid-rows: HorizontalLayout {
                    spacing: 16px;

                    for cell[cidx] in grid-row.cells: AlbumCell {
                        // Short rows are padded with filler cells so the last
                        // row's covers stay the size of every other row's.
                        data: cell;
                        tapped => { root.cell-selected(ridx * root.grid-columns + cidx); }
                    }
                }

                if root.can-load-more: Rectangle {
                    height: 46px;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: grid-more-touch.pressed ? Theme.surface-alt : transparent;

                    grid-more-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.load-more(); }
                    }

                    Text {
                        text: root.busy ? "Loading..." : "Load more";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if !root.grid-mode: Flickable {
            VerticalLayout {
                spacing: 2px;
                alignment: start;

                if root.rows.length == 0: Text {
                    text: root.busy ? "Loading..." : "Nothing here.";
                    font-size: 13px;
                    color: Theme.text-muted;
                }

                for entry[idx] in root.rows: MusicRow {
                    data: entry;
                    tapped => { root.row-selected(idx); }
                }

                // Paging by an explicit tap rather than on-scroll loading:
                // predictable on a touchscreen, and it never fires by accident
                // while someone is just scrolling the list.
                if root.can-load-more: Rectangle {
                    height: 46px;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: more-touch.pressed ? Theme.surface-alt : transparent;

                    more-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.load-more(); }
                    }

                    Text {
                        text: root.busy ? "Loading..." : "Load more";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
