import { Theme } from "theme.slint";
import { WeatherIcon, WeatherStatIcon } from "weather-icon.slint";

// One family-member chip: color dot, name, and their todo completion ratio
// (reuses data already fetched for the Tasks page -- no extra HA calls).
export struct MemberChipData {
    name: string,
    color: color,
    completed: int,
    total: int,
}

component MemberChip inherits Rectangle {
    in property <MemberChipData> member;
    // Tapping the chip toggles this -- drives both the chip's own dimming
    // and (via the same `member-visible` array on AppWindow) whether this
    // member's events show on the calendar below.
    in property <bool> visible-on-calendar;
    callback tapped();

    height: 30px;
    border-radius: 15px;
    background: Theme.surface-alt;
    border-width: 1px;
    border-color: Theme.border;
    opacity: visible-on-calendar ? 1.0 : 0.45;

    TouchArea {
        clicked => { tapped(); }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 12px;
            spacing: 6px;

            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: member.color;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: member.name + " " + member.completed + "/" + member.total;
                font-size: 12px;
                font-weight: 600;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }
    }
}

component WeatherStatRow inherits Rectangle {
    in property <string> kind;
    in property <string> label;
    in property <string> value;

    height: 30px;

    HorizontalLayout {
        spacing: 12px;

        WeatherStatIcon {
            kind: root.kind;
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.label;
            font-size: 14px;
            color: Theme.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.value;
            font-size: 14px;
            font-weight: 600;
            color: Theme.text-primary;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

// The full weather widget -- condition icon, condition label + "X minutes
// ago", current temperature + today's high/low, and pressure/humidity/wind
// stat rows below. Every string is pre-formatted in Rust (see
// apply_weather in main.rs); rows with no data (empty string) are hidden
// rather than shown blank.
export component WeatherWidget inherits Rectangle {
    in property <string> icon-condition;
    in property <string> condition-label;
    in property <string> updated-label;
    in property <string> temp-now: "--°";
    in property <string> temp-range;
    in property <string> pressure;
    in property <string> humidity;
    in property <string> wind;

    background: Theme.surface-alt;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 18px;
        spacing: 14px;

        HorizontalLayout {
            spacing: 16px;

            WeatherIcon {
                condition: root.icon-condition;
                width: 56px;
                height: 56px;
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.condition-label == "" ? "Weather" : root.condition-label;
                    font-size: 22px;
                    font-weight: 700;
                    color: Theme.text-primary;
                }
                Text {
                    text: root.updated-label;
                    font-size: 13px;
                    color: Theme.text-muted;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.temp-now;
                    font-size: 30px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    horizontal-alignment: right;
                }
                Text {
                    text: root.temp-range;
                    font-size: 13px;
                    color: Theme.text-muted;
                    horizontal-alignment: right;
                }
            }
        }

        if root.pressure != "" || root.humidity != "" || root.wind != "": Rectangle {
            height: 1px;
            background: Theme.border;
        }

        if root.pressure != "": WeatherStatRow { kind: "pressure"; label: "Air pressure"; value: root.pressure; }
        if root.humidity != "": WeatherStatRow { kind: "humidity"; label: "Humidity"; value: root.humidity; }
        if root.wind != "": WeatherStatRow { kind: "wind"; label: "Wind speed"; value: root.wind; }
    }
}

// Household name has no config field yet -- left as a plain default rather
// than adding schema for a single cosmetic string this pass.
export component TopBar inherits Rectangle {
    in property <string> family-name: "Family";
    in property <string> clock-text: "--:--";
    in property <string> date-text: "";
    in property <string> weather-icon-condition: "";
    in property <string> weather-condition-label: "";
    in property <string> weather-updated-label: "";
    in property <string> weather-temp-now: "--°";
    in property <string> weather-temp-range: "";
    in property <string> weather-pressure: "";
    in property <string> weather-humidity: "";
    in property <string> weather-wind: "";
    in property <[MemberChipData]> members;
    in property <[bool]> member-visible;
    // Tapping a member's name toggles them on/off the calendar below.
    callback member-toggled(int);

    background: transparent;

    VerticalLayout {
        spacing: 14px;

        HorizontalLayout {
            spacing: Theme.gap;

            Text {
                text: family-name;
                font-size: 22px;
                font-weight: 700;
                color: Theme.text-primary;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            VerticalLayout {
                alignment: center;
                Text {
                    text: date-text;
                    font-size: 11px;
                    color: Theme.text-muted;
                    horizontal-alignment: right;
                }
                Text {
                    text: clock-text;
                    font-size: 26px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    horizontal-alignment: right;
                }
            }
        }

        WeatherWidget {
            icon-condition: root.weather-icon-condition;
            condition-label: root.weather-condition-label;
            updated-label: root.weather-updated-label;
            temp-now: root.weather-temp-now;
            temp-range: root.weather-temp-range;
            pressure: root.weather-pressure;
            humidity: root.weather-humidity;
            wind: root.weather-wind;
        }

        // Scrollable rather than a plain HorizontalLayout: with a large or
        // auto-discovered family (see discover_family in main.rs -- a real
        // household ended up with 10 entries) a fixed-width row of chips
        // can overflow the window, same overflow bug the event-creation
        // form's member picker had.
        Flickable {
            height: 30px;
            HorizontalLayout {
                height: 30px;
                spacing: 8px;
                alignment: start;
                for member[idx] in members: MemberChip {
                    member: member;
                    visible-on-calendar: idx < root.member-visible.length && root.member-visible[idx];
                    tapped => { root.member-toggled(idx); }
                }
            }
        }
    }
}
