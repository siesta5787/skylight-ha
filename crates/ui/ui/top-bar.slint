import { Theme } from "theme.slint";

// One family-member chip: color dot, name, and their todo completion ratio
// (reuses data already fetched for the Tasks page -- no extra HA calls).
export struct MemberChipData {
    name: string,
    color: color,
    completed: int,
    total: int,
}

component MemberChip inherits Rectangle {
    in property <MemberChipData> member;
    // Tapping the chip toggles this -- drives both the chip's own dimming
    // and (via the same `member-visible` array on AppWindow) whether this
    // member's events show on the calendar below.
    in property <bool> visible-on-calendar;
    callback tapped();

    height: 30px;
    border-radius: 15px;
    background: Theme.surface-alt;
    border-width: 1px;
    border-color: Theme.border;
    opacity: visible-on-calendar ? 1.0 : 0.45;

    TouchArea {
        clicked => { tapped(); }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 12px;
            spacing: 6px;

            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: member.color;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: member.name + " " + member.completed + "/" + member.total;
                font-size: 12px;
                font-weight: 600;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }
    }
}

// The family filter chips.
//
// Lives on the Calendar page rather than the header: toggling a member only
// affects the calendar, so showing it above Tasks, Music, Weather and Settings
// was offering a control that did nothing there.
export component MemberChipRow inherits Rectangle {
    in property <[MemberChipData]> members;
    in property <[bool]> member-visible;
    callback member-toggled(int);

    HorizontalLayout {
        alignment: center;
        spacing: 8px;

        for member[idx] in root.members: MemberChip {
            member: member;
            visible-on-calendar: idx < root.member-visible.length && root.member-visible[idx];
            tapped => { root.member-toggled(idx); }
        }
    }
}

// Household name has no config field yet -- left as a plain default rather
// than adding schema for a single cosmetic string this pass.
export component TopBar inherits Rectangle {
    in property <string> family-name: "Family";
    in property <string> clock-text: "--:--";
    in property <string> date-text: "";
    // Split from the clock so AM/PM can sit beside it at its own size rather
    // than being baked into one string.
    in property <string> clock-meridiem: "";
    background: transparent;
    // Explicit, because this element has two children now. A Rectangle hands
    // its own geometry to a layout only when that layout is its *sole* child
    // -- with the centred date beside it, the row would otherwise collapse to
    // its preferred width and take the clock out of the corner with it.
    height: 46px;

    // Centred on the window, not on whatever space the name and clock leave
    // between them: a layout cell sitting between two siblings of unequal
    // width lands wherever those widths put it, which is not the middle of
    // the screen. Declared before the row below so the clock wins if a long
    // household name ever reaches this far across.
    Text {
        text: root.date-text;
        font-size: 26px;
        font-weight: 600;
        color: Theme.text-primary;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: Theme.gap;

        Text {
            text: root.family-name;
            font-size: 22px;
            font-weight: 700;
            color: Theme.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        // Weather used to sit here, between the name and the clock. It has a
        // tab of its own now -- the header is the clock and the date.
        Text {
            text: root.clock-text;
            font-size: 36px;
            font-weight: 700;
            color: Theme.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        Text {
            text: root.clock-meridiem;
            font-size: 26px;
            font-weight: 700;
            color: Theme.text-muted;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }
}
