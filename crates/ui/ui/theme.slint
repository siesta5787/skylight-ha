export global Theme {
    out property <color> background: #14161f;
    out property <color> surface: #1e2130;
    out property <color> surface-alt: #262a3d;
    out property <color> text-primary: #f2f3f7;
    out property <color> text-muted: #9096ab;
    out property <color> accent: #6c8dfa;
    out property <length> radius: 16px;
    out property <length> gap: 16px;
}
