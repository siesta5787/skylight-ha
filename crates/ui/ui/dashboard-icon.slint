import { Theme } from "theme.slint";

// Small hand-drawn icons for the Dashboard page, same conventions as
// sidebar.slint (Path + viewbox for stroke-based glyphs, monochrome via a
// caller-supplied `icon-color`) and weather-icon.slint (percentages only
// work for width/height in Slint -- x/y use `root.width * fraction`
// instead; border-radius: 999px clamps to a circle/pill regardless of
// actual size). No `rotation-angle` anywhere, same as weather-icon.slint --
// unverifiable without a live preview, so avoided in favor of shapes that
// don't need it.

export component LightBulbIcon inherits Rectangle {
    in property <color> icon-color;
    background: transparent;

    Rectangle {
        x: parent.width * 0.22;
        y: 0;
        width: 56%;
        height: 66%;
        border-radius: 999px;
        background: icon-color;
    }
    Rectangle {
        x: parent.width * 0.36;
        y: parent.height * 0.64;
        width: 28%;
        height: 22%;
        border-radius: 2px;
        background: icon-color;
    }
}

// A 4-blade "+"-shaped fan, axis-aligned (no rotation needed).
export component FanIcon inherits Rectangle {
    in property <color> icon-color;
    background: transparent;

    Rectangle {
        x: parent.width * 0.40;
        width: 20%;
        height: 46%;
        border-radius: 999px;
        background: icon-color;
    }
    Rectangle {
        y: parent.height * 0.40;
        width: 46%;
        height: 20%;
        border-radius: 999px;
        background: icon-color;
    }
    Rectangle {
        x: parent.width * 0.36;
        y: parent.height * 0.36;
        width: 28%;
        height: 28%;
        border-radius: 999px;
        background: icon-color;
    }
}

// Climate mode buttons -- `kind` is one of the four hvac_modes any real
// entity on this instance actually has: "off", "fan_only", "cool", "heat".
export component ClimateModeIcon inherits Rectangle {
    in property <string> kind;
    in property <color> icon-color;
    background: transparent;

    if root.kind == "off": Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 999px;
        border-width: 2px;
        border-color: icon-color;

        Rectangle {
            x: parent.width * 0.44;
            y: 0;
            width: 12%;
            height: 40%;
            background: icon-color;
        }
    }

    if root.kind == "fan_only": FanIcon { width: 100%; height: 100%; icon-color: root.icon-color; }

    // A simplified 6-point snowflake (three crossing straight lines).
    if root.kind == "cool": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: icon-color;
        stroke-width: 2px;
        commands: "M12 2 L12 22 M3 7 L21 17 M21 7 L3 17";
    }

    // A simple flame silhouette.
    if root.kind == "heat": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: icon-color;
        commands: "M12 2 L16 9 L20 13 L17 21 L12 23 L7 21 L4 13 L8 9 Z";
    }
}

export component ThermometerIcon inherits Rectangle {
    in property <color> icon-color;
    background: transparent;

    Rectangle {
        x: parent.width * 0.40;
        y: 0;
        width: 20%;
        height: 66%;
        border-radius: 999px;
        background: icon-color;
    }
    Rectangle {
        x: parent.width * 0.22;
        y: parent.height * 0.56;
        width: 56%;
        height: 44%;
        border-radius: 999px;
        background: icon-color;
    }
}

// Static outline -- not dynamically filled to the sensor's own reading;
// the percentage is already shown as text next to it.
export component BatteryIcon inherits Rectangle {
    in property <color> icon-color;
    background: transparent;

    Rectangle {
        width: 82%;
        height: 100%;
        border-radius: 2px;
        border-width: 1.5px;
        border-color: icon-color;
    }
    Rectangle {
        x: parent.width * 0.84;
        y: parent.height * 0.3;
        width: 16%;
        height: 40%;
        border-radius: 1px;
        background: icon-color;
    }
}

// Three ascending bars, like a signal-strength glyph.
export component SignalIcon inherits Rectangle {
    in property <color> icon-color;
    background: transparent;

    // Three bottom-aligned bars, each positioned manually (percentages
    // only apply to width/height in Slint, not x/y) so bar-height + y
    // always sums to the full icon height.
    Rectangle {
        x: 0;
        y: parent.height * 0.66;
        width: 26%;
        height: 34%;
        border-radius: 1px;
        background: icon-color;
    }
    Rectangle {
        x: parent.width * 0.37;
        y: parent.height * 0.40;
        width: 26%;
        height: 60%;
        border-radius: 1px;
        background: icon-color;
    }
    Rectangle {
        x: parent.width * 0.74;
        y: 0;
        width: 26%;
        height: 100%;
        border-radius: 1px;
        background: icon-color;
    }
}

// A sliding pill toggle -- the app had no toggle-switch style before this
// (only the todo checkbox), needed for the header/per-entity switches on
// the Dashboard page's toggle-group cards.
export component ToggleSwitch inherits Rectangle {
    in property <bool> is-on;
    callback toggled();

    width: 42px;
    height: 24px;
    border-radius: 999px;
    background: is-on ? Theme.accent : Theme.border;
    animate background { duration: 150ms; }

    Rectangle {
        x: is-on ? parent.width - self.width - 3px : 3px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 999px;
        background: white;
        animate x { duration: 150ms; easing: ease-out; }
    }

    TouchArea {
        clicked => { root.toggled(); }
    }
}
