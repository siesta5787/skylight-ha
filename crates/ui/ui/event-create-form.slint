import { Theme } from "theme.slint";

// Touch-only v1: which family member's calendar + a duration, no free-text
// title yet -- there's no on-screen keyboard component anywhere in this app
// yet, and building one is a separate, sizable feature. New events get a
// fixed default title for now; renaming afterward happens in HA directly.
export struct EventFormMember {
    name: string,
    color: color,
}

component MemberButton inherits Rectangle {
    in property <EventFormMember> member;
    in property <bool> selected;
    callback tapped();

    width: 64px;
    height: 64px;
    border-radius: 32px;
    background: member.color.with-alpha(selected ? 0.35 : 0.15);
    border-width: selected ? 2px : 0px;
    border-color: member.color;

    TouchArea {
        clicked => { tapped(); }
        VerticalLayout {
            alignment: center;
            Text {
                text: member.name;
                font-size: 11px;
                font-weight: 700;
                color: Theme.text-primary;
                horizontal-alignment: center;
                overflow: elide;
                width: parent.width - 8px;
            }
        }
    }
}

component DurationButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback tapped();

    border-radius: 8px;
    background: selected ? Theme.accent : Theme.surface-alt;
    border-width: 1px;
    border-color: Theme.border;

    TouchArea {
        clicked => { tapped(); }
        Text {
            text: label;
            font-size: 13px;
            font-weight: 600;
            color: selected ? white : Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    callback tapped();

    border-radius: 10px;
    background: primary ? Theme.accent : Theme.surface-alt;
    border-width: 1px;
    border-color: primary ? Theme.accent : Theme.border;

    TouchArea {
        clicked => { tapped(); }
        Text {
            text: label;
            font-size: 15px;
            font-weight: 700;
            color: primary ? white : Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Full-window modal overlay for creating a new HA calendar event. Opened by
// tapping an empty calendar slot (or a "+" button); prefilled with the
// tapped date/time, which Rust already knows and doesn't need to round-trip
// back through here.
export component EventCreateForm inherits Rectangle {
    in property <bool> open: false;
    in property <string> date-label;
    in property <string> time-label;
    in property <[EventFormMember]> members;
    in-out property <int> selected-member: 0;
    in-out property <int> duration-minutes: 60;
    callback confirmed();
    callback cancelled();

    visible: open;
    width: 100%;
    height: 100%;
    background: #14161f99;
    z: 1000;

    // Tapping outside the card dismisses the form.
    TouchArea {
        clicked => { root.cancelled(); }
    }

    Rectangle {
        width: 460px;
        height: 360px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.border;

        VerticalLayout {
            padding: 22px;
            spacing: 14px;

            Text {
                text: "New Event";
                font-size: 18px;
                font-weight: 700;
                color: Theme.text-primary;
            }
            Text {
                text: root.date-label + " · " + root.time-label;
                font-size: 14px;
                color: Theme.text-muted;
            }

            Text {
                text: "Whose calendar?";
                font-size: 12px;
                font-weight: 600;
                color: Theme.text-muted;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                for member[idx] in root.members: MemberButton {
                    member: member;
                    selected: idx == root.selected-member;
                    tapped => { root.selected-member = idx; }
                }
            }

            Text {
                text: "Duration";
                font-size: 12px;
                font-weight: 600;
                color: Theme.text-muted;
            }
            HorizontalLayout {
                spacing: 10px;
                DurationButton {
                    label: "30 min";
                    selected: root.duration-minutes == 30;
                    tapped => { root.duration-minutes = 30; }
                }
                DurationButton {
                    label: "1 hour";
                    selected: root.duration-minutes == 60;
                    tapped => { root.duration-minutes = 60; }
                }
                DurationButton {
                    label: "1.5 hours";
                    selected: root.duration-minutes == 90;
                    tapped => { root.duration-minutes = 90; }
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                spacing: 10px;
                ActionButton {
                    label: "Cancel";
                    primary: false;
                    tapped => { root.cancelled(); }
                }
                ActionButton {
                    label: "Create";
                    primary: true;
                    tapped => { root.confirmed(); }
                }
            }
        }
    }
}
