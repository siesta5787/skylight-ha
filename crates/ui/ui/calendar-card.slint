import { Theme } from "theme.slint";

export struct CalendarEventDot {
    summary: string,
    member-color: color,
    member-index: int,
}

export struct CalendarDayData {
    day-number: int,
    in-current-month: bool,
    is-today: bool,
    events: [CalendarEventDot],
}

component EventLine inherits Rectangle {
    in property <CalendarEventDot> dot;
    // Indexes `member-visible` below -- kept out of layout entirely (not
    // just dimmed) when its member is toggled off in the top bar.
    visible: dot.member-index < 0 || root.member-visible.length == 0
        || dot.member-index >= root.member-visible.length
        || root.member-visible[dot.member-index];
    in property <[bool]> member-visible;
    callback tapped();

    height: 15px;
    background: dot.member-color.with-alpha(touch.pressed ? 0.40 : 0.20);
    border-radius: 3px;

    touch := TouchArea {
        clicked => { root.tapped(); }

        Text {
            x: 4px;
            width: parent.width - 6px;
            text: dot.summary;
            font-size: 9px;
            font-weight: 600;
            color: Theme.text-primary;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

component WeekdayHeader inherits Text {
    color: Theme.text-muted;
    font-size: 12px;
    font-weight: 600;
    horizontal-alignment: center;
}

component DayCell inherits Rectangle {
    in property <CalendarDayData> day;
    in property <[bool]> member-visible;
    // Tapping an empty part of a day cell is how new events get created in
    // Month view too (mirrors tapping an hour slot in Week/Day view).
    callback tapped();
    callback event-tapped(CalendarEventDot);

    border-width: 1px;
    border-color: Theme.border;
    background: touch.pressed
        ? Theme.accent.with-alpha(0.25)
        : (day.is-today ? Theme.accent.with-alpha(0.10) : Theme.surface);
    clip: true;

    touch := TouchArea {
        clicked => { tapped(); }

        VerticalLayout {
            alignment: start;
            padding: 6px;
            spacing: 3px;

            HorizontalLayout {
                Rectangle {
                    width: day.is-today ? 22px : 0px;
                    height: 22px;
                    border-radius: 11px;
                    background: day.is-today ? Theme.accent : transparent;

                    Text {
                        text: day.day-number;
                        color: day.is-today ? white : (day.in-current-month ? Theme.text-primary : Theme.text-muted);
                        font-weight: day.is-today ? 700 : 400;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            for dot in day.events: EventLine {
                dot: dot;
                member-visible: root.member-visible;
                tapped => { root.event-tapped(dot); }
            }
        }
    }
}

// The Month view: a full-bleed grid (grid lines between cells, day number
// top-left, event titles listed directly in the cell) rather than a padded
// card with abstract dots -- closer to a traditional paper wall calendar,
// and stretches to fill the page like the other calendar views do.
export component CalendarCard inherits Rectangle {
    in property <[[CalendarDayData]]> weeks;
    in property <[bool]> member-visible;
    // (week, day) grid indices of the tapped cell -- used to open the
    // event-creation form pre-filled to that date.
    callback day-selected(int /* week */, int /* day */);
    // Handled entirely in `.slint` (see AppWindow) -- everything needed to
    // show details is already in `CalendarEventDot`.
    callback event-tapped(CalendarEventDot);

    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    // A single GridLayout (header + all 42 day cells) rather than 7 separate
    // HorizontalLayouts -- each of those divided the same width completely
    // independently, and rounding could put the leftover pixel in a
    // different column from one row to the next, so column edges visibly
    // zigzagged between weeks. One shared grid guarantees every row uses
    // identical column widths.
    GridLayout {
        Row {
            WeekdayHeader { text: "Sun"; height: 28px; }
            WeekdayHeader { text: "Mon"; height: 28px; }
            WeekdayHeader { text: "Tue"; height: 28px; }
            WeekdayHeader { text: "Wed"; height: 28px; }
            WeekdayHeader { text: "Thu"; height: 28px; }
            WeekdayHeader { text: "Fri"; height: 28px; }
            WeekdayHeader { text: "Sat"; height: 28px; }
        }

        for week[week-idx] in weeks: Row {
            for day[day-idx] in week: DayCell {
                day: day;
                member-visible: root.member-visible;
                tapped => { root.day-selected(week-idx, day-idx); }
                event-tapped(dot) => { root.event-tapped(dot); }
            }
        }
    }
}
