import { Theme } from "theme.slint";

export struct CalendarEventDot {
    member-color: color,
}

export struct CalendarDayData {
    day-number: int,
    in-current-month: bool,
    is-today: bool,
    events: [CalendarEventDot],
}

component WeekdayHeader inherits Text {
    color: Theme.text-muted;
    font-size: 13px;
    horizontal-alignment: center;
}

component DayCell inherits Rectangle {
    in property <CalendarDayData> day;
    in property <bool> selected;
    callback tapped();

    border-radius: 10px;
    border-width: selected ? 2px : 0px;
    border-color: Theme.accent;
    background: touch.pressed
        ? Theme.accent.with-alpha(0.30)
        : (day.is-today ? Theme.accent.with-alpha(0.18) : transparent);

    touch := TouchArea {
        clicked => { tapped(); }

        VerticalLayout {
            alignment: start;
            padding: 6px;
            spacing: 4px;

            Text {
                text: day.day-number;
                color: day.in-current-month ? Theme.text-primary : Theme.text-muted;
                font-weight: day.is-today ? 700 : 400;
                font-size: 15px;
            }

            HorizontalLayout {
                spacing: 3px;
                for dot in day.events: Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: dot.member-color;
                }
            }
        }
    }
}

export component CalendarCard inherits Rectangle {
    in property <[[CalendarDayData]]> weeks;
    in property <string> month-label;
    // Which cell is currently selected, as (week, day) grid indices; -1 = none.
    out property <int> selected-week: -1;
    out property <int> selected-day: -1;
    callback day-selected(int /* week */, int /* day */);

    background: Theme.surface;
    border-radius: Theme.radius;

    VerticalLayout {
        alignment: start;
        padding: 18px;
        spacing: 10px;

        Text {
            text: month-label;
            color: Theme.text-primary;
            font-size: 20px;
            font-weight: 700;
        }

        HorizontalLayout {
            spacing: 4px;
            WeekdayHeader { text: "Sun"; }
            WeekdayHeader { text: "Mon"; }
            WeekdayHeader { text: "Tue"; }
            WeekdayHeader { text: "Wed"; }
            WeekdayHeader { text: "Thu"; }
            WeekdayHeader { text: "Fri"; }
            WeekdayHeader { text: "Sat"; }
        }

        for week[week-idx] in weeks: HorizontalLayout {
            spacing: 4px;
            for day[day-idx] in week: DayCell {
                day: day;
                selected: root.selected-week == week-idx && root.selected-day == day-idx;
                horizontal-stretch: 1;
                height: 64px;
                tapped => {
                    root.selected-week = week-idx;
                    root.selected-day = day-idx;
                    root.day-selected(week-idx, day-idx);
                }
            }
        }
    }
}
