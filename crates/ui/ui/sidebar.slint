import { Theme } from "theme.slint";
import { StarGlyph } from "rewards-view.slint";

// Which full-page section of the app is showing. Page switching is pure
// `.slint` state (see AppWindow) -- Rust never needs to know the current page.
export enum Page {
    Dashboard,
    Calendar,
    Tasks,
    Photos,
    Music,
    Weather,
    Rewards,
    Settings,
}

// Small hand-drawn line icons -- no icon font/asset pipeline exists yet.
// Kept to straight lines and plain rectangles (no arcs/curves) to stay easy
// to get right without a live preview.
component HouseIcon inherits Path {
    in property <color> icon-color;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: icon-color;
    stroke-width: 1.6px;
    commands: "M3 11 L12 4 L21 11 M5.5 9.5 L5.5 20 L18.5 20 L18.5 9.5";
}

component CalendarIcon inherits Rectangle {
    in property <color> icon-color;
    width: 20px;
    height: 20px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 3px;
        border-width: 1.6px;
        border-color: icon-color;
    }
    Rectangle {
        y: 0;
        width: 100%;
        height: 6px;
        background: icon-color;
        border-top-left-radius: 3px;
        border-top-right-radius: 3px;
    }
    Rectangle {
        x: 4px;
        y: -2px;
        width: 2px;
        height: 5px;
        background: icon-color;
    }
    Rectangle {
        x: parent.width - 6px;
        y: -2px;
        width: 2px;
        height: 5px;
        background: icon-color;
    }
}

component TasksIcon inherits Rectangle {
    in property <color> icon-color;
    width: 20px;
    height: 20px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 4px;
        border-width: 1.6px;
        border-color: icon-color;
    }
    Path {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: icon-color;
        stroke-width: 2.4px;
        commands: "M4 13 L9.5 18.5 L20 6";
    }
}

// A quaver: note head plus stem. Straight lines and a rounded rectangle only,
// for the same reason as the other icons here -- no icon font or asset
// pipeline exists, and curves are hard to get right without a live preview.
// A sun: a filled disc with four straight rays. Straight lines only, for the
// same reason as every other icon here -- no icon font, and curves are hard to
// get right without a live preview.
component WeatherIconGlyph inherits Rectangle {
    in property <color> icon-color;
    width: 20px;
    height: 20px;

    Rectangle {
        x: 6px;
        y: 6px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: icon-color;
    }
    Rectangle { x: 9.2px; y: 0px; width: 1.6px; height: 4px; background: icon-color; }
    Rectangle { x: 9.2px; y: 16px; width: 1.6px; height: 4px; background: icon-color; }
    Rectangle { x: 0px; y: 9.2px; width: 4px; height: 1.6px; background: icon-color; }
    Rectangle { x: 16px; y: 9.2px; width: 4px; height: 1.6px; background: icon-color; }
}

component MusicIcon inherits Rectangle {
    in property <color> icon-color;
    width: 20px;
    height: 20px;

    // Note head.
    Rectangle {
        x: 2px;
        y: 12px;
        width: 7px;
        height: 6px;
        border-radius: 3px;
        background: icon-color;
    }

    // Stem.
    Rectangle {
        x: 7.6px;
        y: 2px;
        width: 1.8px;
        height: 13px;
        background: icon-color;
    }

    // Flag.
    Rectangle {
        x: 9.4px;
        y: 2px;
        width: 6px;
        height: 1.8px;
        background: icon-color;
    }
}

component PhotosIcon inherits Rectangle {
    in property <color> icon-color;
    width: 20px;
    height: 20px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 3px;
        border-width: 1.6px;
        border-color: icon-color;
        clip: true;

        Path {
            x: 2px;
            y: parent.height - 11px;
            width: parent.width - 4px;
            height: 9px;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: icon-color;
            commands: "M0 24 L8 12 L13 17 L18 10 L24 24 Z";
        }
    }
}

component SettingsIcon inherits Rectangle {
    in property <color> icon-color;
    width: 20px;
    height: 20px;

    for row in 3: Rectangle {
        y: row * 8px;
        width: 100%;
        height: 2px;
        background: icon-color.with-alpha(0.5);

        Rectangle {
            x: row == 1 ? parent.width - 8px : 2px;
            y: -3px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: icon-color;
        }
    }
}

// A single nav row: an icon plus a small caption, highlighted when it's the
// active page.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    // A small unread-style dot in the top-right corner. Currently only used
    // by Settings, to signal that a software update is available without
    // making the user go looking (see update-overlay.slint / update.rs).
    in property <bool> badge: false;
    callback tapped();

    height: 78px;
    background: touch.pressed ? Theme.border : transparent;

    touch := TouchArea {
        // Sized explicitly. It used to be this Rectangle's sole child and
        // relied on Slint's implicit "fill the parent" behaviour, which is
        // documented in this project's CLAUDE.md as unreliable the moment a
        // second child appears -- and the badge dot below is exactly that
        // second child. Getting this wrong breaks touch on the whole nav rail.
        width: 100%;
        height: 100%;

        clicked => { tapped(); }

        VerticalLayout {
            alignment: center;
            spacing: 14px;

            Rectangle {
                @children
            }

            Text {
                text: label;
                font-size: 10px;
                color: active ? Theme.accent : Theme.text-muted;
                horizontal-alignment: center;
            }
        }
    }

    // Declared after the TouchArea so it paints on top; absolutely positioned
    // so it takes part in no layout and cannot disturb the icon/caption
    // column above. Always present, only `visible` toggling -- not an `if`,
    // for the same reason.
    Rectangle {
        visible: root.badge;
        x: parent.width - self.width - 14px;
        y: 12px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: #e0607a;
    }
}

export component Sidebar inherits Rectangle {
    in property <Page> active-page;
    // Dot on the Settings nav item, set when the updater has found an
    // installable newer release. Nothing here auto-installs -- this is the
    // whole of the "come and look" nudge.
    in property <bool> settings-badge: false;
    callback page-selected(Page);

    width: Theme.sidebar-width;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    property <color> dashboard-color: root.active-page == Page.Dashboard ? Theme.accent : Theme.text-muted;
    property <color> calendar-color: root.active-page == Page.Calendar ? Theme.accent : Theme.text-muted;
    property <color> tasks-color: root.active-page == Page.Tasks ? Theme.accent : Theme.text-muted;
    property <color> photos-color: root.active-page == Page.Photos ? Theme.accent : Theme.text-muted;
    property <color> music-color: root.active-page == Page.Music ? Theme.accent : Theme.text-muted;
    property <color> weather-color: root.active-page == Page.Weather ? Theme.accent : Theme.text-muted;
    property <color> rewards-color: root.active-page == Page.Rewards ? Theme.accent : Theme.text-muted;
    property <color> settings-color: root.active-page == Page.Settings ? Theme.accent : Theme.text-muted;

    VerticalLayout {
        alignment: start;
        padding-top: 12px;

        NavItem {
            label: "Dashboard";
            active: root.active-page == Page.Dashboard;
            tapped => { root.page-selected(Page.Dashboard); }
            HouseIcon { icon-color: root.dashboard-color; }
        }
        NavItem {
            label: "Calendar";
            active: root.active-page == Page.Calendar;
            tapped => { root.page-selected(Page.Calendar); }
            CalendarIcon { icon-color: root.calendar-color; }
        }
        NavItem {
            label: "Tasks";
            active: root.active-page == Page.Tasks;
            tapped => { root.page-selected(Page.Tasks); }
            TasksIcon { icon-color: root.tasks-color; }
        }
        NavItem {
            label: "Photos";
            active: root.active-page == Page.Photos;
            tapped => { root.page-selected(Page.Photos); }
            PhotosIcon { icon-color: root.photos-color; }
        }

        NavItem {
            label: "Music";
            active: root.active-page == Page.Music;
            tapped => { root.page-selected(Page.Music); }
            MusicIcon { icon-color: root.music-color; }
        }

        NavItem {
            label: "Weather";
            active: root.active-page == Page.Weather;
            tapped => { root.page-selected(Page.Weather); }
            WeatherIconGlyph { icon-color: root.weather-color; }
        }

        NavItem {
            label: "Rewards/Money";
            active: root.active-page == Page.Rewards;
            tapped => { root.page-selected(Page.Rewards); }
            StarGlyph {
                width: 22px;
                height: 22px;
                fill-color: root.rewards-color;
            }
        }

        // Pushes Settings to the bottom of the rail rather than packing
        // directly under Rewards.
        Rectangle { vertical-stretch: 1; }

        NavItem {
            label: "Settings";
            active: root.active-page == Page.Settings;
            badge: root.settings-badge;
            tapped => { root.page-selected(Page.Settings); }
            SettingsIcon { icon-color: root.settings-color; }
        }
    }
}
