import { Theme } from "theme.slint";
import { Sidebar, Page } from "sidebar.slint";
import { TopBar, MemberChipRow, MemberChipData } from "top-bar.slint";
import { CalendarCard, CalendarDayData, CalendarEventDot } from "calendar-card.slint";
import { CalendarViewSwitcher, CalendarViewMode } from "calendar-view-switcher.slint";
import { TimeGridView, WeekDayColumnData, WeekEventData, AllDayBannerData } from "time-grid-view.slint";
import { AgendaView } from "agenda-view.slint";
import { TodoCard, TodoColumnData } from "todo-card.slint";
import { PlaceholderView } from "placeholder-view.slint";
import { EventCreateForm, EventFormMember } from "event-create-form.slint";
import { EventDetailView } from "event-detail-view.slint";
import { VirtualKeyboard } from "virtual-keyboard.slint";
import { DashboardPage, DashboardCardData, DashboardRowData, ToggleEntityData, SensorRowData } from "dashboard-view.slint";
import { PinPad } from "pin-pad.slint";
import { SettingsPage } from "settings-view.slint";
import { UpdateOverlay } from "update-overlay.slint";
import { TimezonePicker } from "timezone-picker.slint";
import { WifiView, WifiNetworkData } from "wifi-view.slint";
import { MusicPage, MusicRowData, MusicGridRowData } from "music-view.slint";
import { WeatherPage } from "weather-view.slint";
import { RewardsPage, RewardMemberData, RewardDayData } from "rewards-view.slint";
// Embeds the font at compile time (Slint's recommended approach -- see
// i-slint-compiler's font import handling) since the target device has no
// system fonts or fontconfig at all (see crates/ui/Cargo.toml).
import "../assets/fonts/Inter-Regular.ttf";

export {
    CalendarDayData, CalendarEventDot, TodoColumnData, WeekDayColumnData, WeekEventData,
    AllDayBannerData, MemberChipData, EventFormMember, DashboardCardData, DashboardRowData,
    ToggleEntityData, SensorRowData, Page, WifiNetworkData, MusicRowData, MusicGridRowData,
    RewardMemberData, RewardDayData,
}

component NavArrow inherits Rectangle {
    in property <string> glyph;
    callback tapped();

    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: touch.pressed ? Theme.border : transparent;

    touch := TouchArea {
        clicked => { tapped(); }
        Text {
            text: glyph;
            font-size: 16px;
            font-weight: 700;
            color: Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component TodayButton inherits Rectangle {
    callback tapped();

    border-radius: 8px;
    background: touch.pressed ? Theme.border : Theme.surface-alt;
    border-width: 1px;
    border-color: Theme.border;

    touch := TouchArea {
        clicked => { tapped(); }
        Text {
            text: "Today";
            font-size: 13px;
            font-weight: 600;
            color: Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component SyncButton inherits Rectangle {
    callback tapped();

    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: touch.pressed ? Theme.border : Theme.surface-alt;
    border-width: 1px;
    border-color: Theme.border;

    touch := TouchArea {
        clicked => { tapped(); }
        // "Sync" spelled out rather than a refresh-arrows glyph -- no icon
        // font/asset pipeline exists yet (see sidebar.slint).
        Text {
            text: "Sync";
            font-size: 9px;
            font-weight: 700;
            color: Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component NewEventButton inherits Rectangle {
    callback tapped();

    width: 56px;
    height: 56px;
    border-radius: 28px;
    background: touch.pressed ? Theme.accent.darker(0.15) : Theme.accent;

    touch := TouchArea {
        clicked => { tapped(); }
        Text {
            text: "+";
            font-size: 28px;
            font-weight: 700;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    title: "Family Dashboard";
    background: Theme.background;
    preferred-width: 1280px;
    preferred-height: 800px;
    default-font-family: "Inter";

    in property <string> clock-text: "--:--";
    in property <string> clock-meridiem: "";
    // Minutes since midnight, for the "now" line on the Day/Week grids. -1
    // until the clock is worth trusting -- this board boots at the kernel
    // epoch, and a line drawn at 1970's idea of the time would be worse than
    // no line at all.
    in property <int> now-minutes: -1;
    in property <string> date-text: "";
    in property <string> month-label: "";
    // All empty/placeholder until a weather entity is resolved and its first
    // fetch succeeds -- the Weather page shows "--°" and hides the cards it
    // has no data for until then. Set from `apply_weather` in main.rs; see
    // that function for how each is sourced (some optionally backfilled from
    // a second entity). Nothing here reaches the header any more.
    in property <string> weather-icon-condition: "";
    in property <string> weather-condition-label: "";
    in property <string> weather-updated-label: "";
    in property <string> weather-temp-now: "--°";
    in property <string> weather-temp-range: "";
    in property <string> weather-precip: "";
    in property <string> weather-pressure: "";
    in property <string> weather-humidity: "";
    in property <string> weather-wind: "";

    // The Rewards tab, fed from the Skylight Family integration's star
    // sensors (see the `rewards` module in main.rs). Empty until the first
    // entity fetch lands, or permanently if nobody has reward tracking turned
    // on -- `rewards-message` says which.
    in property <[RewardMemberData]> rewards-members: [];
    in property <string> rewards-message: "";
    in property <[MemberChipData]> members;
    in property <[DashboardRowData]> dashboard-rows;
    callback dashboard-entity-toggled(string, bool);
    callback dashboard-group-toggled([string], bool);
    callback dashboard-climate-mode-selected(string, string);
    callback dashboard-climate-temp-delta(string, int);

    // Parental PIN lock (Dashboard/Settings nav gating) -- see PinFlow in
    // main.rs for the setup/change/disable state machine driving these.
    in-out property <bool> pin-configured: false;
    // Re-locks (see Sidebar wiring below) the moment you navigate away
    // from Dashboard/Settings to Calendar/Tasks/Photos -- moving between
    // Dashboard and Settings themselves does not re-lock.
    in-out property <bool> pin-unlocked: false;
    in property <bool> pin-pad-open: false;
    in property <string> pin-pad-prompt: "Enter PIN";
    in property <string> pin-pad-error: "";
    in property <int> pin-pad-digit-count: 0;
    callback pin-digit-pressed(string);
    callback pin-backspace-pressed();
    callback pin-pad-cancelled();
    callback pin-nav-requested(Page);
    callback pin-setup-requested();
    callback pin-change-requested();
    callback pin-disable-requested();

    // In-app software update (see apps/skylight-ha/src/update.rs). Everything
    // here is Rust-computed: which of "never checked"/"checking"/"up to
    // date"/"failed"/"available"/"needs a reflash"/"previously failed" the
    // status line says is a judgement Rust already makes to persist
    // state.json, so `.slint` doesn't second-guess it.
    in property <string> update-version-line: "";
    in property <string> update-build-line: "";
    in property <string> update-status-text: "";
    in property <string> update-notes: "";
    // Two separate flags on purpose: `available` means "there is something
    // newer worth telling you about" (drives the Settings nav badge), while
    // `installable` means "and this device can install it itself" (drives the
    // Install button). A release flagged `requires_reflash` in its manifest is
    // the first without being the second.
    in property <bool> update-available: false;
    in property <bool> update-installable: false;
    in property <string> update-install-label: "Install update";
    in property <bool> update-busy: false;
    callback update-check-requested();
    callback update-install-requested();
    // Set once the binary has actually been swapped, a beat before exit(0).
    in property <bool> update-overlay-open: false;
    in property <string> update-overlay-title: "Updating...";
    in property <string> update-overlay-detail: "";

    // Music (Navidrome via Subsonic, played on an HA media_player). Rust owns
    // which level of the browse hierarchy is showing and supplies labelled
    // rows, so the navigation rules stay testable rather than living in markup.
    in property <bool> music-configured: false;
    in property <string> music-server-label: "";
    in property <string> music-message: "";
    in property <bool> music-busy: false;
    in property <bool> music-player-configured: false;
    in property <string> music-player-name: "";
    in property <string> music-now-playing-title: "";
    in property <string> music-now-playing-artist: "";
    in property <bool> music-now-playing-active: false;
    in property <image> music-now-playing-art;
    in property <string> music-volume-label: "";
    callback music-volume-pressed(int);
    callback music-volume-released();
    in-out property <bool> music-now-playing-view: false;
    in property <[string]> music-sections: [];
    in property <int> music-selected-section: 0;
    in property <string> music-heading: "";
    in property <bool> music-can-go-back: false;
    in property <[MusicRowData]> music-rows: [];
    in property <bool> music-sorts-visible: false;
    in property <[string]> music-sorts: [];
    in property <int> music-selected-sort: 0;
    in property <bool> music-can-load-more: false;
    in property <bool> music-grid-mode: false;
    in property <[MusicGridRowData]> music-grid-rows: [];
    in property <int> music-grid-columns: 4;
    callback music-sort-selected(int);
    callback music-load-more();
    // Fired when the Music tab is opened, so the library refreshes instead of
    // showing whatever was loaded at app startup.
    callback music-tab-opened();
    callback music-setup-requested();
    callback music-forget-requested();
    callback music-section-selected(int);
    callback music-row-selected(int);
    callback music-back();
    callback music-choose-player();
    callback music-play-pause();
    callback music-next-track();
    callback music-previous-track();

    // Wi-Fi. Scanning and connecting are blocking control-socket calls run off
    // the UI thread; everything here is the result they publish back.
    in property <string> wifi-status: "";
    in property <bool> wifi-view-open: false;
    in property <string> wifi-message: "";
    in property <bool> wifi-busy: false;
    in property <[WifiNetworkData]> wifi-networks: [];
    callback wifi-manage-requested();
    callback wifi-network-selected(int);
    callback wifi-rescan();
    callback wifi-view-closed();

    // Time zone. The picker is a dumb list: Rust owns which level of the
    // continent -> country -> zone drill-down is showing and hands over
    // already-labelled rows, so the grouping logic stays in timezone.rs where
    // it is unit-tested rather than living in markup.
    in property <string> timezone-name: "";
    in property <string> timezone-detail: "";
    in property <bool> tz-picker-open: false;
    in property <string> tz-picker-title: "Time Zone";
    in property <string> tz-picker-breadcrumb: "";
    in property <[string]> tz-picker-rows: [];
    in property <bool> tz-picker-leaf: false;
    in property <int> tz-picker-selected-index: -1;
    in property <bool> tz-picker-can-go-back: false;
    callback timezone-change-requested();
    callback tz-picker-row-selected(int);
    callback tz-picker-back();
    callback tz-picker-cancelled();

    // Kept out of layout entirely (not just dimmed) for whichever member a
    // top-bar chip tap has toggled off -- indexed the same as `members`.
    // Rust initializes this once (all `true`, matching `members`' length)
    // and never touches it again; toggling is pure `.slint` state from then
    // on, same as page/calendar-mode switching.
    in-out property <[bool]> member-visible;

    in property <[[CalendarDayData]]> calendar-month;
    in property <[WeekDayColumnData]> calendar-week;
    in property <[WeekDayColumnData]> calendar-day;
    in property <[WeekDayColumnData]> calendar-agenda;
    in property <[string]> hour-labels;

    in property <[TodoColumnData]> todo-columns;
    callback todo-item-toggled(int, int);
    // Opens the virtual keyboard (below) prefilled/targeted for this
    // column; Rust owns what "done" means (add the item to this column's
    // todo entity in HA).
    callback add-task-requested(int /* column */);

    // The keyboard owns no text state itself (see virtual-keyboard.slint);
    // Rust maintains the actual buffer and pushes it back down here after
    // every keystroke. Reused for anything that needs typed input, not
    // just adding a task -- `keyboard-prompt` says what it's for.
    in property <bool> keyboard-open: false;
    in property <string> keyboard-prompt: "";
    in property <string> keyboard-text: "";
    callback keyboard-key-pressed(string);
    callback keyboard-backspace-pressed();
    callback keyboard-done();
    callback keyboard-cancelled();

    // Rust resolves these back to an actual date using its own
    // `reference_date` (whatever Month/Week/Day is currently centered on --
    // moved by the nav callbacks below), so "column 3" or "grid cell (2,4)"
    // is always unambiguous without threading a date through Slint.
    callback month-slot-tapped(int /* week */, int /* day */);
    callback week-slot-tapped(int /* column */, int /* hour */);
    callback day-slot-tapped(int /* hour */);
    callback new-event-requested();

    // Prev/next moves `reference_date` by a day/week/month depending on
    // which calendar mode is active -- decided below in `.slint` (Rust
    // doesn't track the mode), then Rust re-fetches/rebuilds around the new
    // date. Agenda has no nav controls (see time-grid-view/agenda-view: it
    // always looks forward from "now", not from `reference_date`).
    callback nav-month(int /* delta */);
    callback nav-week(int /* delta */);
    callback nav-day(int /* delta */);
    callback nav-today();
    // Manual force-refresh -- the periodic 5-min timer usually handles it,
    // but tapping "Sync" doesn't need to wait on that.
    callback manual-refresh-requested();

    // The event-creation form's open/prefill state is Rust-driven (it has
    // to compute the date/time labels from whichever slot was tapped);
    // which member/duration is selected is the form's own internal state,
    // read back via `event_form.*` when it's confirmed.
    in-out property <bool> event-form-open: false;
    in property <string> event-form-date-label;
    in property <string> event-form-time-label;
    in property <[EventFormMember]> event-form-members;
    // Reset to all-`false` (matching event-form-members' current length)
    // every time the form opens, same reasoning as member-visible above --
    // the form's own component can't be reset from Rust directly, only
    // AppWindow's own properties can.
    in-out property <[bool]> event-form-selected-members;
    // Like keyboard-text: comes from the virtual keyboard (a separate modal
    // on top of this one), pushed back down here after every keystroke.
    in property <string> event-form-title;
    callback event-form-title-tapped();
    callback event-create-confirmed([bool] /* selected members, parallel to event-form-members */, int /* duration minutes */);

    // Viewing an existing event's details is handled entirely in `.slint`:
    // everything needed (summary/time/color/member index) is already in the
    // `WeekEventData` that was tapped, no Rust round-trip required.
    property <bool> event-detail-open: false;
    property <string> event-detail-summary;
    property <string> event-detail-time;
    property <string> event-detail-member-name;
    property <[color]> event-detail-member-colors;

    // Page/view-mode switching is pure `.slint` state -- Rust never needs to
    // know which page or calendar mode is active.
    // in-out (not the plain `property` this used to be) so Rust can also
    // set it directly -- a correct PIN entry switches straight to
    // whichever page was gated, from the pin_digit_pressed handler.
    in-out property <Page> current-page: Page.Calendar;
    property <CalendarViewMode> current-calendar-mode: CalendarViewMode.Month;

    function show-event-detail(ev: WeekEventData) {
        event-detail-summary = ev.summary;
        event-detail-time = ev.time-label;
        event-detail-member-colors = ev.member-colors;
        event-detail-member-name = ev.member-label;
        event-detail-open = true;
    }

    function show-calendar-event-detail(dot: CalendarEventDot) {
        event-detail-summary = dot.summary;
        event-detail-time = dot.time-label;
        event-detail-member-colors = dot.member-colors;
        event-detail-member-name = dot.member-label;
        event-detail-open = true;
    }

    HorizontalLayout {
        Sidebar {
            active-page: root.current-page;
            settings-badge: root.update-available;
            page-selected(p) => {
                if (p == Page.Dashboard || p == Page.Settings) && root.pin-configured && !root.pin-unlocked {
                    root.pin-nav-requested(p);
                } else {
                    root.current-page = p;
                    if p != Page.Dashboard && p != Page.Settings {
                        root.pin-unlocked = false;
                    }
                    // Opening the tab is exactly when the library should be
                    // current; without this it showed whatever was fetched at
                    // app startup, so music added since never appeared.
                    if p == Page.Music {
                        root.music-tab-opened();
                    }
                }
            }
        }

        Rectangle {
            background: Theme.background;
            horizontal-stretch: 1;

            VerticalLayout {
                padding: 20px;
                spacing: Theme.gap;

                TopBar {
                    clock-text: root.clock-text;
                    clock-meridiem: root.clock-meridiem;
                    date-text: root.date-text;
                }

                if root.current-page == Page.Calendar: VerticalLayout {
                    spacing: Theme.gap;
                    vertical-stretch: 1;

                    HorizontalLayout {
                        spacing: 10px;

                        // Agenda always looks forward from "now" and isn't
                        // centered on `reference_date`, so navigating it
                        // wouldn't do anything meaningful -- hidden there.
                        if root.current-calendar-mode != CalendarViewMode.Agenda: NavArrow {
                            glyph: "<";
                            tapped => {
                                if root.current-calendar-mode == CalendarViewMode.Month {
                                    root.nav-month(-1);
                                } else if root.current-calendar-mode == CalendarViewMode.Week {
                                    root.nav-week(-1);
                                } else {
                                    root.nav-day(-1);
                                }
                            }
                        }
                        if root.current-calendar-mode != CalendarViewMode.Agenda: NavArrow {
                            glyph: ">";
                            tapped => {
                                if root.current-calendar-mode == CalendarViewMode.Month {
                                    root.nav-month(1);
                                } else if root.current-calendar-mode == CalendarViewMode.Week {
                                    root.nav-week(1);
                                } else {
                                    root.nav-day(1);
                                }
                            }
                        }
                        if root.current-calendar-mode != CalendarViewMode.Agenda: TodayButton {
                            tapped => { root.nav-today(); }
                        }

                        Text {
                            text: root.month-label;
                            font-size: 20px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                        // Centred between the date and the view switcher. These
                        // only affect the calendar, which is why they're no
                        // longer in the header on every page.
                        MemberChipRow {
                            horizontal-stretch: 1;
                            members: root.members;
                            member-visible: root.member-visible;
                            member-toggled(idx) => {
                                if idx >= 0 && idx < root.member-visible.length {
                                    root.member-visible[idx] = !root.member-visible[idx];
                                }
                            }
                        }
                        CalendarViewSwitcher {
                            mode: root.current-calendar-mode;
                            mode-selected(m) => { root.current-calendar-mode = m; }
                        }
                        SyncButton {
                            tapped => { root.manual-refresh-requested(); }
                        }
                    }

                    calendar-body := Rectangle {
                        vertical-stretch: 1;

                        if root.current-calendar-mode == CalendarViewMode.Month: CalendarCard {
                            width: 100%;
                            height: 100%;
                            weeks: root.calendar-month;
                            member-visible: root.member-visible;
                            day-selected(week, day) => { root.month-slot-tapped(week, day); }
                            event-tapped(dot) => { root.show-calendar-event-detail(dot); }
                        }
                        if root.current-calendar-mode == CalendarViewMode.Week: TimeGridView {
                            width: 100%;
                            height: 100%;
                            days: root.calendar-week;
                            member-visible: root.member-visible;
                            now-minutes: root.now-minutes;
                            hour-labels: root.hour-labels;
                            slot-tapped(col, hour) => { root.week-slot-tapped(col, hour); }
                            event-tapped(ev) => { root.show-event-detail(ev); }
                        }
                        if root.current-calendar-mode == CalendarViewMode.Day: TimeGridView {
                            width: 100%;
                            height: 100%;
                            days: root.calendar-day;
                            member-visible: root.member-visible;
                            now-minutes: root.now-minutes;
                            hour-labels: root.hour-labels;
                            slot-tapped(col, hour) => { root.day-slot-tapped(hour); }
                            event-tapped(ev) => { root.show-event-detail(ev); }
                        }
                        if root.current-calendar-mode == CalendarViewMode.Agenda: AgendaView {
                            width: 100%;
                            height: 100%;
                            days: root.calendar-agenda;
                            member-visible: root.member-visible;
                            event-tapped(ev) => { root.show-event-detail(ev); }
                        }

                        NewEventButton {
                            x: calendar-body.width - self.width - 16px;
                            y: calendar-body.height - self.height - 16px;
                            tapped => { root.new-event-requested(); }
                        }
                    }
                }

                if root.current-page == Page.Tasks: VerticalLayout {
                    spacing: Theme.gap;
                    vertical-stretch: 1;

                    // No Sync button here (unlike Calendar) -- todos push
                    // near-instantly over HA's event stream (see
                    // run_ha_sync's state_changed subscription), so there's
                    // nothing a manual refresh would meaningfully speed up.
                    TodoCard {
                        columns: root.todo-columns;
                        vertical-stretch: 1;
                        item-toggled(col, item) => { root.todo-item-toggled(col, item); }
                        add-item-requested(col) => { root.add-task-requested(col); }
                    }
                }

                if root.current-page == Page.Dashboard: DashboardPage {
                    rows: root.dashboard-rows;
                    vertical-stretch: 1;
                    entity-toggled(id, on) => { root.dashboard-entity-toggled(id, on); }
                    group-toggled(ids, on) => { root.dashboard-group-toggled(ids, on); }
                    climate-mode-selected(id, mode) => { root.dashboard-climate-mode-selected(id, mode); }
                    climate-temp-delta(id, delta) => { root.dashboard-climate-temp-delta(id, delta); }
                }

                if root.current-page == Page.Weather: WeatherPage {
                    vertical-stretch: 1;
                    icon-condition: root.weather-icon-condition;
                    condition-label: root.weather-condition-label;
                    updated-label: root.weather-updated-label;
                    temp-now: root.weather-temp-now;
                    temp-range: root.weather-temp-range;
                    precip: root.weather-precip;
                    pressure: root.weather-pressure;
                    humidity: root.weather-humidity;
                    wind: root.weather-wind;
                }

                if root.current-page == Page.Rewards: RewardsPage {
                    vertical-stretch: 1;
                    members: root.rewards-members;
                    message: root.rewards-message;
                }

                if root.current-page == Page.Music: MusicPage {
                    vertical-stretch: 1;
                    configured: root.music-configured;
                    message: root.music-message;
                    busy: root.music-busy;
                    player-configured: root.music-player-configured;
                    player-name: root.music-player-name;
                    now-playing-title: root.music-now-playing-title;
                    now-playing-artist: root.music-now-playing-artist;
                    now-playing-active: root.music-now-playing-active;
                    now-playing-art: root.music-now-playing-art;
                    volume-label: root.music-volume-label;
                    volume-pressed(d) => { root.music-volume-pressed(d); }
                    volume-released => { root.music-volume-released(); }
                    now-playing-view: root.music-now-playing-view;
                    open-now-playing => {
                        if (root.music-player-configured) {
                            root.music-now-playing-view = true;
                        }
                    }
                    close-now-playing => { root.music-now-playing-view = false; }
                    sections: root.music-sections;
                    selected-section: root.music-selected-section;
                    heading: root.music-heading;
                    can-go-back: root.music-can-go-back;
                    rows: root.music-rows;
                    sorts-visible: root.music-sorts-visible;
                    sorts: root.music-sorts;
                    selected-sort: root.music-selected-sort;
                    can-load-more: root.music-can-load-more;
                    grid-mode: root.music-grid-mode;
                    grid-rows: root.music-grid-rows;
                    grid-columns: root.music-grid-columns;
                    // Flat index: rows are padded to full width, so
                    // row * columns + column addresses the same list Rust
                    // already holds actions for.
                    cell-selected(i) => { root.music-row-selected(i); }
                    sort-selected(i) => { root.music-sort-selected(i); }
                    load-more => { root.music-load-more(); }
                    setup-requested => { root.music-setup-requested(); }
                    section-selected(i) => { root.music-section-selected(i); }
                    row-selected(i) => { root.music-row-selected(i); }
                    back => { root.music-back(); }
                    choose-player => {
                        // The picker renders in the browse area, so leave the
                        // now-playing view or the tap would appear to do
                        // nothing.
                        root.music-now-playing-view = false;
                        root.music-choose-player();
                    }
                    play-pause => { root.music-play-pause(); }
                    next-track => { root.music-next-track(); }
                    previous-track => { root.music-previous-track(); }
                }

                if root.current-page == Page.Photos: PlaceholderView {
                    title: "Photos";
                    subtitle: "Will show your Immich library here.";
                    vertical-stretch: 1;
                }

                if root.current-page == Page.Settings: SettingsPage {
                    pin-configured: root.pin-configured;
                    vertical-stretch: 1;
                    pin-setup-requested => { root.pin-setup-requested(); }
                    pin-change-requested => { root.pin-change-requested(); }
                    pin-disable-requested => { root.pin-disable-requested(); }

                    update-version-line: root.update-version-line;
                    update-build-line: root.update-build-line;
                    update-status-text: root.update-status-text;
                    update-notes: root.update-notes;
                    update-installable: root.update-installable;
                    update-install-label: root.update-install-label;
                    update-busy: root.update-busy;
                    update-check-requested => { root.update-check-requested(); }
                    update-install-requested => { root.update-install-requested(); }

                    wifi-status: root.wifi-status;
                    wifi-manage-requested => { root.wifi-manage-requested(); }

                    music-server-label: root.music-server-label;
                    music-configured: root.music-configured;
                    music-forget-requested => { root.music-forget-requested(); }

                    timezone-name: root.timezone-name;
                    timezone-detail: root.timezone-detail;
                    timezone-change-requested => { root.timezone-change-requested(); }
                }
            }
        }
    }

    event_form := EventCreateForm {
        open: root.event-form-open;
        date-label: root.event-form-date-label;
        time-label: root.event-form-time-label;
        title: root.event-form-title;
        members: root.event-form-members;
        selected-members: root.event-form-selected-members;
        title-tapped => { root.event-form-title-tapped(); }
        cancelled => { root.event-form-open = false; }
        confirmed => {
            root.event-form-open = false;
            root.event-create-confirmed(event_form.selected-members, event_form.duration-minutes);
        }
    }

    EventDetailView {
        open: root.event-detail-open;
        summary: root.event-detail-summary;
        time-label: root.event-detail-time;
        member-name: root.event-detail-member-name;
        member-colors: root.event-detail-member-colors;
        closed => { root.event-detail-open = false; }
    }

    VirtualKeyboard {
        open: root.keyboard-open;
        prompt: root.keyboard-prompt;
        text: root.keyboard-text;
        key-pressed(ch) => { root.keyboard-key-pressed(ch); }
        backspace-pressed => { root.keyboard-backspace-pressed(); }
        done => { root.keyboard-done(); }
        cancelled => { root.keyboard-cancelled(); }
    }

    PinPad {
        open: root.pin-pad-open;
        prompt: root.pin-pad-prompt;
        error-text: root.pin-pad-error;
        digit-count: root.pin-pad-digit-count;
        digit-pressed(d) => { root.pin-digit-pressed(d); }
        backspace-pressed => { root.pin-backspace-pressed(); }
        cancelled => { root.pin-pad-cancelled(); }
    }

    // A *top-level sibling*, exactly like PinPad above and deliberately not
    // nested inside SettingsPage's conditional state -- see the long comment
    // in update-overlay.slint (and the reverted Logs page in CLAUDE.md) for
    // why that distinction breaks touch across the whole app.
    UpdateOverlay {
        open: root.update-overlay-open;
        title: root.update-overlay-title;
        detail: root.update-overlay-detail;
    }

    WifiView {
        open: root.wifi-view-open;
        status-line: root.wifi-status;
        message: root.wifi-message;
        busy: root.wifi-busy;
        networks: root.wifi-networks;
        network-selected(i) => { root.wifi-network-selected(i); }
        rescan => { root.wifi-rescan(); }
        closed => { root.wifi-view-closed(); }
    }

    // Same top-level-sibling shape as the three overlays above, for the same
    // reason -- see the comment in timezone-picker.slint.
    TimezonePicker {
        open: root.tz-picker-open;
        title: root.tz-picker-title;
        breadcrumb: root.tz-picker-breadcrumb;
        rows: root.tz-picker-rows;
        leaf: root.tz-picker-leaf;
        selected-index: root.tz-picker-selected-index;
        can-go-back: root.tz-picker-can-go-back;
        row-selected(i) => { root.tz-picker-row-selected(i); }
        back => { root.tz-picker-back(); }
        cancelled => { root.tz-picker-cancelled(); }
    }
}
