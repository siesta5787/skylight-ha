import { Theme } from "theme.slint";
import { Sidebar, Page } from "sidebar.slint";
import { TopBar, MemberChipData } from "top-bar.slint";
import { CalendarCard, CalendarDayData, CalendarEventDot } from "calendar-card.slint";
import { CalendarViewSwitcher, CalendarViewMode } from "calendar-view-switcher.slint";
import { TimeGridView, WeekDayColumnData, WeekEventData, AllDayBannerData } from "time-grid-view.slint";
import { AgendaView } from "agenda-view.slint";
import { TodoCard, TodoColumnData } from "todo-card.slint";
import { PlaceholderView } from "placeholder-view.slint";
import { EventCreateForm, EventFormMember } from "event-create-form.slint";
import { EventDetailView } from "event-detail-view.slint";
import { VirtualKeyboard } from "virtual-keyboard.slint";
import { DashboardPage, DashboardCardData, DashboardRowData, ToggleEntityData, SensorRowData } from "dashboard-view.slint";
// Embeds the font at compile time (Slint's recommended approach -- see
// i-slint-compiler's font import handling) since the target device has no
// system fonts or fontconfig at all (see crates/ui/Cargo.toml).
import "../assets/fonts/Inter-Regular.ttf";

export {
    CalendarDayData, CalendarEventDot, TodoColumnData, WeekDayColumnData, WeekEventData,
    AllDayBannerData, MemberChipData, EventFormMember, DashboardCardData, DashboardRowData,
    ToggleEntityData, SensorRowData,
}

component NavArrow inherits Rectangle {
    in property <string> glyph;
    callback tapped();

    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: touch.pressed ? Theme.border : transparent;

    touch := TouchArea {
        clicked => { tapped(); }
        Text {
            text: glyph;
            font-size: 16px;
            font-weight: 700;
            color: Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component TodayButton inherits Rectangle {
    callback tapped();

    border-radius: 8px;
    background: touch.pressed ? Theme.border : Theme.surface-alt;
    border-width: 1px;
    border-color: Theme.border;

    touch := TouchArea {
        clicked => { tapped(); }
        Text {
            text: "Today";
            font-size: 13px;
            font-weight: 600;
            color: Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component SyncButton inherits Rectangle {
    callback tapped();

    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: touch.pressed ? Theme.border : Theme.surface-alt;
    border-width: 1px;
    border-color: Theme.border;

    touch := TouchArea {
        clicked => { tapped(); }
        // "Sync" spelled out rather than a refresh-arrows glyph -- no icon
        // font/asset pipeline exists yet (see sidebar.slint).
        Text {
            text: "Sync";
            font-size: 9px;
            font-weight: 700;
            color: Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component NewEventButton inherits Rectangle {
    callback tapped();

    width: 56px;
    height: 56px;
    border-radius: 28px;
    background: touch.pressed ? Theme.accent.darker(0.15) : Theme.accent;

    touch := TouchArea {
        clicked => { tapped(); }
        Text {
            text: "+";
            font-size: 28px;
            font-weight: 700;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    title: "Family Dashboard";
    background: Theme.background;
    preferred-width: 1280px;
    preferred-height: 800px;
    default-font-family: "Inter";

    in property <string> clock-text: "--:--";
    in property <string> date-text: "";
    in property <string> month-label: "";
    // All empty/placeholder until a weather entity is resolved and its
    // first fetch succeeds -- WeatherWidget falls back to plain "Weather"/
    // "--°" text and hides rows it has no data for until then. Set from
    // `apply_weather` in main.rs; see that function for how each is
    // sourced (some optionally backfilled from a second entity).
    in property <string> weather-icon-condition: "";
    in property <string> weather-condition-label: "";
    in property <string> weather-updated-label: "";
    in property <string> weather-temp-now: "--°";
    in property <string> weather-temp-range: "";
    in property <string> weather-precip: "";
    in property <string> weather-pressure: "";
    in property <string> weather-humidity: "";
    in property <string> weather-wind: "";
    in property <[MemberChipData]> members;
    in property <[DashboardRowData]> dashboard-rows;
    callback dashboard-entity-toggled(string, bool);
    callback dashboard-group-toggled([string], bool);
    callback dashboard-climate-mode-selected(string, string);
    callback dashboard-climate-temp-delta(string, int);
    // Kept out of layout entirely (not just dimmed) for whichever member a
    // top-bar chip tap has toggled off -- indexed the same as `members`.
    // Rust initializes this once (all `true`, matching `members`' length)
    // and never touches it again; toggling is pure `.slint` state from then
    // on, same as page/calendar-mode switching.
    in-out property <[bool]> member-visible;

    in property <[[CalendarDayData]]> calendar-month;
    in property <[WeekDayColumnData]> calendar-week;
    in property <[WeekDayColumnData]> calendar-day;
    in property <[WeekDayColumnData]> calendar-agenda;
    in property <[string]> hour-labels;

    in property <[TodoColumnData]> todo-columns;
    callback todo-item-toggled(int, int);
    // Opens the virtual keyboard (below) prefilled/targeted for this
    // column; Rust owns what "done" means (add the item to this column's
    // todo entity in HA).
    callback add-task-requested(int /* column */);

    // The keyboard owns no text state itself (see virtual-keyboard.slint);
    // Rust maintains the actual buffer and pushes it back down here after
    // every keystroke. Reused for anything that needs typed input, not
    // just adding a task -- `keyboard-prompt` says what it's for.
    in property <bool> keyboard-open: false;
    in property <string> keyboard-prompt: "";
    in property <string> keyboard-text: "";
    callback keyboard-key-pressed(string);
    callback keyboard-backspace-pressed();
    callback keyboard-done();
    callback keyboard-cancelled();

    // Rust resolves these back to an actual date using its own
    // `reference_date` (whatever Month/Week/Day is currently centered on --
    // moved by the nav callbacks below), so "column 3" or "grid cell (2,4)"
    // is always unambiguous without threading a date through Slint.
    callback month-slot-tapped(int /* week */, int /* day */);
    callback week-slot-tapped(int /* column */, int /* hour */);
    callback day-slot-tapped(int /* hour */);
    callback new-event-requested();

    // Prev/next moves `reference_date` by a day/week/month depending on
    // which calendar mode is active -- decided below in `.slint` (Rust
    // doesn't track the mode), then Rust re-fetches/rebuilds around the new
    // date. Agenda has no nav controls (see time-grid-view/agenda-view: it
    // always looks forward from "now", not from `reference_date`).
    callback nav-month(int /* delta */);
    callback nav-week(int /* delta */);
    callback nav-day(int /* delta */);
    callback nav-today();
    // Manual force-refresh -- the periodic 5-min timer usually handles it,
    // but tapping "Sync" doesn't need to wait on that.
    callback manual-refresh-requested();

    // The event-creation form's open/prefill state is Rust-driven (it has
    // to compute the date/time labels from whichever slot was tapped);
    // which member/duration is selected is the form's own internal state,
    // read back via `event_form.*` when it's confirmed.
    in-out property <bool> event-form-open: false;
    in property <string> event-form-date-label;
    in property <string> event-form-time-label;
    in property <[EventFormMember]> event-form-members;
    // Reset to all-`false` (matching event-form-members' current length)
    // every time the form opens, same reasoning as member-visible above --
    // the form's own component can't be reset from Rust directly, only
    // AppWindow's own properties can.
    in-out property <[bool]> event-form-selected-members;
    // Like keyboard-text: comes from the virtual keyboard (a separate modal
    // on top of this one), pushed back down here after every keystroke.
    in property <string> event-form-title;
    callback event-form-title-tapped();
    callback event-create-confirmed([bool] /* selected members, parallel to event-form-members */, int /* duration minutes */);

    // Viewing an existing event's details is handled entirely in `.slint`:
    // everything needed (summary/time/color/member index) is already in the
    // `WeekEventData` that was tapped, no Rust round-trip required.
    property <bool> event-detail-open: false;
    property <string> event-detail-summary;
    property <string> event-detail-time;
    property <string> event-detail-member-name;
    property <[color]> event-detail-member-colors;

    // Page/view-mode switching is pure `.slint` state -- Rust never needs to
    // know which page or calendar mode is active.
    property <Page> current-page: Page.Calendar;
    property <CalendarViewMode> current-calendar-mode: CalendarViewMode.Month;

    function show-event-detail(ev: WeekEventData) {
        event-detail-summary = ev.summary;
        event-detail-time = ev.time-label;
        event-detail-member-colors = ev.member-colors;
        event-detail-member-name = ev.member-label;
        event-detail-open = true;
    }

    function show-calendar-event-detail(dot: CalendarEventDot) {
        event-detail-summary = dot.summary;
        event-detail-time = dot.time-label;
        event-detail-member-colors = dot.member-colors;
        event-detail-member-name = dot.member-label;
        event-detail-open = true;
    }

    HorizontalLayout {
        Sidebar {
            active-page: root.current-page;
            page-selected(p) => { root.current-page = p; }
        }

        Rectangle {
            background: Theme.background;
            horizontal-stretch: 1;

            VerticalLayout {
                padding: 20px;
                spacing: Theme.gap;

                TopBar {
                    clock-text: root.clock-text;
                    date-text: root.date-text;
                    weather-icon-condition: root.weather-icon-condition;
                    weather-condition-label: root.weather-condition-label;
                    weather-updated-label: root.weather-updated-label;
                    weather-temp-now: root.weather-temp-now;
                    weather-temp-range: root.weather-temp-range;
                    weather-precip: root.weather-precip;
                    weather-pressure: root.weather-pressure;
                    weather-humidity: root.weather-humidity;
                    weather-wind: root.weather-wind;
                    members: root.members;
                    member-visible: root.member-visible;
                    member-toggled(idx) => {
                        if idx >= 0 && idx < root.member-visible.length {
                            root.member-visible[idx] = !root.member-visible[idx];
                        }
                    }
                }

                if root.current-page == Page.Calendar: VerticalLayout {
                    spacing: Theme.gap;
                    vertical-stretch: 1;

                    HorizontalLayout {
                        spacing: 10px;

                        // Agenda always looks forward from "now" and isn't
                        // centered on `reference_date`, so navigating it
                        // wouldn't do anything meaningful -- hidden there.
                        if root.current-calendar-mode != CalendarViewMode.Agenda: NavArrow {
                            glyph: "<";
                            tapped => {
                                if root.current-calendar-mode == CalendarViewMode.Month {
                                    root.nav-month(-1);
                                } else if root.current-calendar-mode == CalendarViewMode.Week {
                                    root.nav-week(-1);
                                } else {
                                    root.nav-day(-1);
                                }
                            }
                        }
                        if root.current-calendar-mode != CalendarViewMode.Agenda: NavArrow {
                            glyph: ">";
                            tapped => {
                                if root.current-calendar-mode == CalendarViewMode.Month {
                                    root.nav-month(1);
                                } else if root.current-calendar-mode == CalendarViewMode.Week {
                                    root.nav-week(1);
                                } else {
                                    root.nav-day(1);
                                }
                            }
                        }
                        if root.current-calendar-mode != CalendarViewMode.Agenda: TodayButton {
                            tapped => { root.nav-today(); }
                        }

                        Text {
                            text: root.month-label;
                            font-size: 20px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        CalendarViewSwitcher {
                            mode: root.current-calendar-mode;
                            mode-selected(m) => { root.current-calendar-mode = m; }
                        }
                        SyncButton {
                            tapped => { root.manual-refresh-requested(); }
                        }
                    }

                    calendar-body := Rectangle {
                        vertical-stretch: 1;

                        if root.current-calendar-mode == CalendarViewMode.Month: CalendarCard {
                            width: 100%;
                            height: 100%;
                            weeks: root.calendar-month;
                            member-visible: root.member-visible;
                            day-selected(week, day) => { root.month-slot-tapped(week, day); }
                            event-tapped(dot) => { root.show-calendar-event-detail(dot); }
                        }
                        if root.current-calendar-mode == CalendarViewMode.Week: TimeGridView {
                            width: 100%;
                            height: 100%;
                            days: root.calendar-week;
                            member-visible: root.member-visible;
                            hour-labels: root.hour-labels;
                            slot-tapped(col, hour) => { root.week-slot-tapped(col, hour); }
                            event-tapped(ev) => { root.show-event-detail(ev); }
                        }
                        if root.current-calendar-mode == CalendarViewMode.Day: TimeGridView {
                            width: 100%;
                            height: 100%;
                            days: root.calendar-day;
                            member-visible: root.member-visible;
                            hour-labels: root.hour-labels;
                            slot-tapped(col, hour) => { root.day-slot-tapped(hour); }
                            event-tapped(ev) => { root.show-event-detail(ev); }
                        }
                        if root.current-calendar-mode == CalendarViewMode.Agenda: AgendaView {
                            width: 100%;
                            height: 100%;
                            days: root.calendar-agenda;
                            member-visible: root.member-visible;
                            event-tapped(ev) => { root.show-event-detail(ev); }
                        }

                        NewEventButton {
                            x: calendar-body.width - self.width - 16px;
                            y: calendar-body.height - self.height - 16px;
                            tapped => { root.new-event-requested(); }
                        }
                    }
                }

                if root.current-page == Page.Tasks: VerticalLayout {
                    spacing: Theme.gap;
                    vertical-stretch: 1;

                    // No Sync button here (unlike Calendar) -- todos push
                    // near-instantly over HA's event stream (see
                    // run_ha_sync's state_changed subscription), so there's
                    // nothing a manual refresh would meaningfully speed up.
                    TodoCard {
                        columns: root.todo-columns;
                        vertical-stretch: 1;
                        item-toggled(col, item) => { root.todo-item-toggled(col, item); }
                        add-item-requested(col) => { root.add-task-requested(col); }
                    }
                }

                if root.current-page == Page.Dashboard: DashboardPage {
                    rows: root.dashboard-rows;
                    vertical-stretch: 1;
                    entity-toggled(id, on) => { root.dashboard-entity-toggled(id, on); }
                    group-toggled(ids, on) => { root.dashboard-group-toggled(ids, on); }
                    climate-mode-selected(id, mode) => { root.dashboard-climate-mode-selected(id, mode); }
                    climate-temp-delta(id, delta) => { root.dashboard-climate-temp-delta(id, delta); }
                }

                if root.current-page == Page.Photos: PlaceholderView {
                    title: "Photos";
                    subtitle: "Will show your Immich library here.";
                    vertical-stretch: 1;
                }

                if root.current-page == Page.Settings: PlaceholderView {
                    title: "Settings";
                    subtitle: "Coming soon.";
                    vertical-stretch: 1;
                }
            }
        }
    }

    event_form := EventCreateForm {
        open: root.event-form-open;
        date-label: root.event-form-date-label;
        time-label: root.event-form-time-label;
        title: root.event-form-title;
        members: root.event-form-members;
        selected-members: root.event-form-selected-members;
        title-tapped => { root.event-form-title-tapped(); }
        cancelled => { root.event-form-open = false; }
        confirmed => {
            root.event-form-open = false;
            root.event-create-confirmed(event_form.selected-members, event_form.duration-minutes);
        }
    }

    EventDetailView {
        open: root.event-detail-open;
        summary: root.event-detail-summary;
        time-label: root.event-detail-time;
        member-name: root.event-detail-member-name;
        member-colors: root.event-detail-member-colors;
        closed => { root.event-detail-open = false; }
    }

    VirtualKeyboard {
        open: root.keyboard-open;
        prompt: root.keyboard-prompt;
        text: root.keyboard-text;
        key-pressed(ch) => { root.keyboard-key-pressed(ch); }
        backspace-pressed => { root.keyboard-backspace-pressed(); }
        done => { root.keyboard-done(); }
        cancelled => { root.keyboard-cancelled(); }
    }
}
